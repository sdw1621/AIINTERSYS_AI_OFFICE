# 이 파일을 복사해 .env 로 저장한 뒤 값을 채우세요. (.env는 GitHub에 올라가지 않습니다)
# API 키 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── 선택 설정 (비워두면 기본값) ──
# CLAUDE_MODEL=claude-opus-5
# MANAGER_EFFORT=high        # 팀장 사고 깊이: low | medium | high | xhigh | max
# WORKER_EFFORT=medium       # 팀원 사고 깊이
# MAX_MANAGER_TURNS=8        # 팀장이 업무를 나눠주는 최대 횟수 (비용 상한 역할)
# ENABLE_WEB_SEARCH=true     # 리서처 웹 검색 사용
# ENABLE_FALLBACK=true       # 안전 정책으로 거절되면 서버에서 대체 모델로 자동 재시도
# PORT=3000
