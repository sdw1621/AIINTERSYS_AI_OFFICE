# 이 파일을 복사해 .env 로 저장한 뒤 값을 채우세요. (.env는 GitHub에 올라가지 않습니다)

# 접속 코드: 실제 사람·일정이 담기므로 공개 배포에서는 반드시 설정
OFFICE_PASSCODE=

# 구글 캘린더 → 설정 → 해당 캘린더 → '비공개 주소(iCal 형식)'
# 프로젝트 이름이 들어간 일정만 화면에 나오고, 나머지 개인 일정은 서버 밖으로 나가지 않습니다.
GCAL_ICS_URL=

# Neon DB: 보고함 + (iCal 주소가 없을 때) 동기화해 둔 일정
DATABASE_URL=

# PORT=3000

# 단톡방 자동 수집(PC 스크립트)용 업로드 키
IMPORT_KEY=
# 구글 시트 IMPORTDATA용 CSV 키
SHEET_EXPORT_KEY=
# AI 음성 회의 LLM (OpenAI 호환). 비우면 규칙 기반 대본
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
